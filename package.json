{
  "name": "cecilia-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "start": "astro preview --host 127.0.0.1 --port ${PORT:-4321}",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test:unit": "timeout 60s vitest run tests/unit",
    "test:coverage": "timeout 60s vitest run tests/unit --coverage",
    "test:integration": "timeout 120s vitest run tests/integration",
    "test:bdd": "bddgen && timeout 300s playwright test --project=bdd",
    "test:e2e": "timeout 300s playwright test --project=e2e",
    "test:smoke": "timeout 120s playwright test --project=smoke",
    "validate": "npm run format:check && npm run lint && npm run check && npm run test:coverage && npm run build",
    "test:generated": "npm run validate && npm run test:integration && npm run test:bdd && npm run test:e2e && npm run test:smoke"
  },
  "dependencies": {
    "@fontsource/nunito-sans": "^5.3.0",
    "astro": "~7.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "eslint-plugin-astro": "3.1.0",
    "get-port": "7.2.0",
    "globals": "17.11.0",
    "playwright": "1.62.1",
    "playwright-bdd": "9.2.0",
    "playwright-core": "1.62.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
